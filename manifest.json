{
  "manifest_version": 3,
  "name": "MoreSpamPlease",
  "version": "0.3.0",
  "description": "Mark Junk messages as Not Junk and move them to their own account's Inbox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "more-spam-please@local.invalid",
      "strict_min_version": "160.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "alarms",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}